{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RightPeek",
  "version": "0.3.0",
  "identifier": "com.rightpeek.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Aydin Kazemi",
    "copyright": "Copyright (c) 2026 Aydin Kazemi",
    "category": "Utility",
    "shortDescription": "Show selected text right-to-left in a clean viewer",
    "longDescription": "RightPeek is a tray app: select text in any app, press a shortcut, and read it with correct right-to-left layout.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
