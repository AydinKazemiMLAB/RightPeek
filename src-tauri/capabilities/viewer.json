{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "viewer",
  "description": "Viewer window: pull captured text, report readiness, persist font size and justify, open Settings, listen for new text, close itself.",
  "windows": ["viewer"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "allow-take-pending-text",
    "allow-viewer-ready",
    "allow-set-font-size",
    "allow-set-justify",
    "allow-open-settings"
  ]
}
